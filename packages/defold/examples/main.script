-- Loads one example collection at a time: press 1, 2 or 3 to switch.
local EXAMPLES = { "slimes", "candle", "events" }
local COLORS = {
	slimes = vmath.vector4(0.16, 0.19, 0.26, 1),
	candle = vmath.vector4(0.043, 0.051, 0.078, 1),
	events = vmath.vector4(0.12, 0.16, 0.2, 1),
}

local function show(self, name)
	if self.current == name or self.loading then
		return
	end
	if self.current then
		msg.post("#" .. self.current, "unload")
	end
	self.loading = name
	msg.post("#" .. name, "async_load")
end

function init(self)
	msg.post(".", "acquire_input_focus")
	-- dmengine --config=spritebuddy.start=candle opens another example first.
	show(self, sys.get_config_string("spritebuddy.start", "slimes"))
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "enable")
		self.current = self.loading
		self.loading = nil
		msg.post("@render:", "clear_color", { color = COLORS[self.current] })
	end
end

function on_input(self, action_id, action)
	for i, name in ipairs(EXAMPLES) do
		if action_id == hash("example_" .. i) and action.pressed then
			show(self, name)
		end
	end
end
