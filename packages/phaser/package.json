{
  "name": "@spritebuddy/phaser",
  "version": "0.3.0",
  "description": "Play SpriteBuddy animations in Phaser 3 and 4: per-frame timing, offsets, live layers and normal-mapped lighting.",
  "license": "ISC",
  "author": "Patrick Hammond",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Patrick-Hammond/spritebuddy-runtimes.git",
    "directory": "packages/phaser"
  },
  "keywords": [
    "spritebuddy",
    "phaser",
    "phaser3",
    "phaser4",
    "spritesheet",
    "animation",
    "gamedev"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@spritebuddy/core": "^0.3.0"
  },
  "peerDependencies": {
    "phaser": ">=3.60.0 <5"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  },
  "devDependencies": {
    "phaser3": "npm:phaser@3.90.0",
    "phaser4": "npm:phaser@4.2.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
