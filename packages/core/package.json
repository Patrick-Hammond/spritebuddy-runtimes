{
  "name": "@spritebuddy/core",
  "version": "0.1.0",
  "description": "Reads SpriteBuddy animation files and works out what to draw at any moment. No dependencies, any engine.",
  "license": "ISC",
  "author": "Patrick Hammond",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Patrick-Hammond/spritebuddy-runtimes.git",
    "directory": "packages/core"
  },
  "keywords": [
    "spritebuddy",
    "sprites",
    "spritesheet",
    "animation",
    "gamedev"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp ../../schema/spritebuddy-animations.v3.schema.json schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
