-- Frame events: the walk tags "squelch" on the frame the slime lands on each step, and the jump
-- tags "land". The slime's script sends a frame_event message for each one as its frame starts
-- showing, and this script plays a sound for it. Space makes the slime jump.
local shared = require "examples.shared"

local SCALE = 6
local SPEED = 70

function init(self)
	msg.post(".", "acquire_input_focus")
	self.direction = 1
	self.jumping = false
	self.lines = {}
	shared.events.squelches = 0
	shared.events.lands = 0
	-- Sending `listen` (or `play`) makes the slime send its frame events here.
	msg.post("slime#spritebuddy", "listen")
end

local function log(self, text)
	table.insert(self.lines, 1, text)
	self.lines[4] = nil
	label.set_text("#log", table.concat(self.lines, "\n"))
end

local function jump(self)
	if not self.jumping then
		self.jumping = true
		msg.post("slime#spritebuddy", "play", { animation = "jump" })
	end
end

function update(self, dt)
	if self.jumping then
		return
	end
	local p = go.get_position("slime")
	p.x = p.x + self.direction * SPEED * dt
	if p.x > 860 or p.x < 100 then
		-- Turn round at the edges.
		self.direction = -self.direction
		msg.post("slime#spritebuddy", "flip", { x = self.direction < 0 })
	end
	go.set_position(p, "slime")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("frame_event") then
		if message.name == hash("squelch") then
			sound.play("#squelch", { speed = 0.9 + 0.2 * math.random() })
			shared.events.squelches = shared.events.squelches + 1
		elseif message.name == hash("land") then
			sound.play("#land")
			shared.events.lands = shared.events.lands + 1
		end
		log(self, ('frame_event "%s" on frame %d'):format(message.event, message.index))
	elseif message_id == hash("animation_finished") and message.animation == hash("jump") then
		self.jumping = false
		msg.post(sender, "play", { animation = "walk" })
	elseif message_id == hash("jump") then
		jump(self)
	end
end

function on_input(self, action_id, action)
	if (action_id == hash("jump") or action_id == hash("touch")) and action.pressed then
		jump(self)
	end
end
