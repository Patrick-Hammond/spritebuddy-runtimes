{
  "name": "spritebuddy-runtimes",
  "private": true,
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage",
    "examples": "npm run build && node scripts/build-playground.mjs && echo \"Examples at http://localhost:8080/examples/\" && esbuild --servedir=. --serve=8080",
    "examples:assets": "node scripts/example-assets.mjs && prettier --write godot/examples/art",
    "examples:sounds": "node scripts/example-sounds.mjs",
    "examples:site": "npm run build && node scripts/build-playground.mjs --site"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.63.0",
    "prettier": "^3.10.0",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
