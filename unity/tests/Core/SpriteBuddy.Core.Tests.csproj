<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity package's pure C# core (Runtime/Core) against the shared golden fixtures,
       without Unity. Run: dotnet run, from the project folder unity/tests/Core -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity 6 compiles C# 9. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../com.spritebuddy.runtime/Runtime/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
