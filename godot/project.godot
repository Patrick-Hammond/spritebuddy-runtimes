; Test and example project for the SpriteBuddy addon. Copy addons/spritebuddy into your own
; project; examples/slime_demo.tscn (the main scene) shows it in use.
config_version=5

[application]

config/name="SpriteBuddy addon tests"
run/main_scene="res://examples/slime_demo.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=480
window/size/viewport_height=240
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/spritebuddy/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
