; Test project for the SpriteBuddy addon. Copy addons/spritebuddy into your own project.
config_version=5

[application]

config/name="SpriteBuddy addon tests"
config/features=PackedStringArray("4.3")

[editor_plugins]

enabled=PackedStringArray("res://addons/spritebuddy/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
